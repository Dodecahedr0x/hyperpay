# Secret key: base58 string, JSON byte array, or a path to a keypair file.
# For agents, use a dedicated session key funded with a bounded amount —
# never your main wallet. When the signer is a session key, pass
# `authority` (the wallet that owns the User PDA) on user instructions.
HYPERPAY_KEY=~/.config/solana/id.json

# mainnet | devnet | a custom RPC URL
HYPERPAY_CLUSTER=devnet

# Optional overrides
# HYPERPAY_RPC=https://api.devnet.solana.com
# HYPERPAY_EPHEMERAL_RPC=https://devnet.magicblock.app
# HYPERPAY_TOKEN=USDC
# HYPERPAY_TOKENS=TEST:7u1w42mrzdPqU2Mw8ngkKjXEbdcYEKdM1yjnwezqJtDo:6

# Spend policy. Checked before anything is signed; fails closed for tokens
# that have no cap configured.
HYPERPAY_MAX_PER_TX=25 USDC
HYPERPAY_DAILY_CAP=200 USDC
# HYPERPAY_ALLOW=
# HYPERPAY_DENY=
# HYPERPAY_JOURNAL=~/.hyperpay/spend.json

# When the signer is a session key, the Rust example (`cargo run -p hyperpay
# --example pay`) reads this as the wallet that owns the User PDA. The
# TypeScript CLI uses `--authority` instead.
# HYPERPAY_AUTHORITY=
