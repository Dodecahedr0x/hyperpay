{
  "name": "@magicblock-labs/hyperpay-types",
  "version": "0.1.0",
  "description": "Shared types, errors, and amount helpers for HyperPay.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicblock-labs/hyperpay.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/magicblock-labs/hyperpay/issues"
  },
  "homepage": "https://github.com/magicblock-labs/hyperpay/tree/main/packages/types#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./amounts": {
      "types": "./dist/amounts.d.ts",
      "import": "./dist/amounts.js",
      "default": "./dist/amounts.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
