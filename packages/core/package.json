{
  "name": "@magicblock-labs/hyperpay-core",
  "version": "0.1.2",
  "description": "HyperPay client: quote, pay, deposit, withdraw, and spend policy.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/node-install.js",
    "./src/node-install.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicblock-labs/hyperpay.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/magicblock-labs/hyperpay/issues"
  },
  "homepage": "https://github.com/magicblock-labs/hyperpay/tree/main/packages/core#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "node": "./dist/index.js",
        "browser": "./dist/browser.js",
        "default": "./dist/browser.js"
      },
      "default": {
        "node": "./dist/index.js",
        "browser": "./dist/browser.js",
        "default": "./dist/browser.js"
      }
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./signer": {
      "types": "./dist/signer-node.d.ts",
      "import": {
        "node": "./dist/signer-node.js",
        "browser": "./dist/signer-browser.js",
        "default": "./dist/signer-browser.js"
      },
      "default": {
        "node": "./dist/signer-node.js",
        "browser": "./dist/signer-browser.js",
        "default": "./dist/signer-browser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@magicblock-labs/hyperpay-solana": "*",
    "@magicblock-labs/hyperpay-types": "*",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0"
  }
}
